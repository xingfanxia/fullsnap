{
  "name": "fullsnap",
  "version": "0.1.0",
  "description": "Chrome extension that captures a whole web page as one image",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc",
    "e2e": "npm run build && tsx scripts/e2e/run.ts"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "private": true
}
